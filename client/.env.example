# ==========================================
# MINDMAP AI — Frontend Environment Variables
# ==========================================

# Production Backend URL (Render Deployment)
# Set this in your Vercel Project Dashboard -> Settings -> Environment Variables
# Key: VITE_API_URL
# Value: https://mindmap-ai-sir3.onrender.com/api
VITE_API_URL=https://mindmap-ai-sir3.onrender.com/api

# For local development with Vite proxy to localhost:5000,
# you can leave VITE_API_URL commented out or empty:
# VITE_API_URL=
