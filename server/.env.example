# ==============================================================================
# MINDMAP AI — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env in the server/ directory:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production secret keys to Git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection String
# For local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/mindmap_ai
# For MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mindmap_ai?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=cosmic_mindmap_jwt_secret_key_2026_super_secure_academic_token
JWT_EXPIRE=30d

# ==============================================================================
# AI Provider Configuration (Google Gemini API)
# ==============================================================================
# 1. Obtain a free Google Gemini API key at Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 2. Paste your API key below:
#    GEMINI_API_KEY=AIzaSy...
#
# NOTE: This key remains strictly on the backend and is never exposed to the client.
#
# If GEMINI_API_KEY is left empty:
# - The application automatically activates the built-in Cosmic CS Knowledge Engine.
# - Full multi-turn conversational context, technical explanations, and assessments continue to work offline!
GEMINI_API_KEY=
